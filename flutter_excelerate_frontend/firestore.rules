rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'admin'
        && userDoc(request.auth.uid).data.isActive == true;
    }

    function keepsProtectedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['uid', 'email', 'photo', 'role', 'isActive', 'adminDepartment', 'adminAccessLevel', 'createdAt']);
    }

    function canSelfPromoteWithActiveAdminCode(userId) {
      return isOwner(userId)
        && exists(/databases/$(database)/documents/admin_config/access)
        && get(/databases/$(database)/documents/admin_config/access).data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && resource.data.role == 'student'
        && request.resource.data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'student'
        && request.resource.data.isActive == true;

      allow read: if isOwner(userId) || isAdmin();

      allow update: if canSelfPromoteWithActiveAdminCode(userId) || (
        isOwner(userId)
        && keepsProtectedUserFields()
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    match /daily_pulses/{pulseId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /programs/{programId} {
      allow read: if signedIn() && (resource.data.isPublished == true || isAdmin());
      allow create, update, delete: if isAdmin();

      match /modules/{moduleId} {
        allow read: if signedIn()
          && (
            isAdmin()
            || get(/databases/$(database)/documents/programs/$(programId)).data.isPublished == true
          );
        allow create, update, delete: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /admin_config/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
